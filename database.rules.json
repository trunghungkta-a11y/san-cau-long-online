{
  "rules": {
    "badminton": {
      ".read": "auth != null",
      "courts": {
        "$court": {
          ".write": "auth != null",
          ".validate": "$court.matches(/^[0-8]$/)"
        }
      },
      "pos": {
        "$court": {
          ".write": "auth != null",
          ".validate": "$court.matches(/^[0-8]$/)"
        }
      },
      "shots": {
        "$court": {
          ".write": "auth != null",
          ".validate": "$court.matches(/^[0-8]$/)"
        }
      },
      "intents": {
        "$court": {
          ".write": "auth != null",
          ".validate": "$court.matches(/^[0-8]$/)"
        }
      },
      "calls": {
        "$court": {
          ".write": "auth != null",
          ".validate": "$court.matches(/^[0-8]$/)"
        }
      },
      "chat": {
        "$room": {
          ".validate": "$room.matches(/^(hall|c[0-8])$/)",
          "$msg": {
            ".write": "auth != null && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['n', 't', 'ts', 'u'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 14"
            },
            "t": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 600000"
            },
            "u": {
              ".validate": "newData.val() === auth.uid"
            },
            "r": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "p": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "b": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
